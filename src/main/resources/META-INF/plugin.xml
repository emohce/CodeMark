<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>emohce</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>CodeMark</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>emohce</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        CodeMark provides structured bookmarks and guided navigation.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <idea-version since-build="253.*" />
    <depends>com.intellij.modules.platform</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup
            id="CodeRemarkTour"
            displayType="BALLOON"
            isLogByDefault="true"/>
        <editor.linePainter implementation="emohce.presentation.editor.linepainter.BookmarkLineEndPainter"/>
        <toolWindow
            id="CodeRemarkTour"
            factoryClass="emohce.presentation.toolwindow.CodeRemarkTourToolWindowFactory"
            icon="/META-INF/pluginIcon.png"
            anchor="right"
            secondary="false"/>
        <postStartupActivity implementation="emohce.core.startup.BookmarkStartupActivity"/>
    </extensions>

    <actions>
        <action id="CodeRemarkTour.CreateBookmarkAtCaret"
                class="emohce.presentation.action.CreateBookmarkAtCaretAction"
                text="Add CodeMark Here"
                description="Create a codemark at the current caret">
            <keyboard-shortcut keymap="$default" first-keystroke="shift F2"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="CodeRemarkTour.CreateProcessAtCaret"
                class="emohce.presentation.action.CreateProcessAtCaretAction"
                text="Add Process Entry Here"
                description="Create a process with entry at the current caret">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="CodeRemarkTour.CreateGroupAtCaret"
                class="emohce.presentation.action.CreateGroupAtCaretAction"
                text="Add Group Here"
                description="Create a group under the current selection">
            <keyboard-shortcut keymap="$default" first-keystroke="shift F3"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="CodeRemarkTour.CreateNoteAtCaret"
                class="emohce.presentation.action.CreateNoteAtCaretAction"
                text="Add Note Here"
                description="Create a note under the current selection">
            <keyboard-shortcut keymap="$default" first-keystroke="shift F4"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="CodeRemarkTour.NextCodemark"
                class="emohce.presentation.action.NextCodemarkAction"
                text="Next CodeMark"
                description="Go to next CodeMark in tree order">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift DOWN"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="CodeRemarkTour.PrevCodemark"
                class="emohce.presentation.action.PrevCodemarkAction"
                text="Prev CodeMark"
                description="Go to previous CodeMark in tree order">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift UP"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="CodeRemarkTour.DeleteCodeMarkAtCaret"
                class="emohce.presentation.action.DeleteCodeMarkAtCaretAction"
                text="Delete CodeMark"
                description="Delete CodeMark at current line">
            <keyboard-shortcut keymap="$default" first-keystroke="shift DELETE"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
